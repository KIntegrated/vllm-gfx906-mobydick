# Ported from 0c33/mi50-vllm-lab (Apache-2.0),
# https://github.com/0c33/mi50-vllm-lab/blob/main/docker/gfx906-blocking-sync.pth
# Forces hipSetDeviceFlags(4) (blocking sync) when VLLM_GFX906_HIP_BLOCKING_SYNC!=0.
# Diagnostic lever for the sync-cadence wedge family; not a default.
import os,sys; exec("if os.environ.get('VLLM_GFX906_HIP_BLOCKING_SYNC', '1') not in ('0', 'false', 'False'):\n import ctypes\n try:\n  _hip = None\n  for _path in (os.environ.get('VLLM_GFX906_HIP_LIB_PATH', ''), 'libamdhip64.so.7', 'libamdhip64.so'):\n   if not _path:\n    continue\n   try:\n    _hip = ctypes.CDLL(_path, mode=ctypes.RTLD_GLOBAL)\n    break\n   except OSError:\n    pass\n  if _hip is not None:\n   _ndev = ctypes.c_int(0)\n   _hip.hipGetDeviceCount(ctypes.byref(_ndev))\n   for _i in range(_ndev.value):\n    _hip.hipSetDevice(_i)\n    _hip.hipSetDeviceFlags(4)\n   _hip.hipSetDevice(0)\n except Exception:\n  pass\n")
